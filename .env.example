# Every variable the code reads, in one place.
#
# This file is the reference. For day-to-day work copy the per-app examples
# instead, since each app loads only its own file and must only ever see its
# own variables:
#
#   cp apps/api/.env.example apps/api/.env.local
#   cp apps/web/.env.example apps/web/.env.local
#
# Never put real values in this file — it is committed. `.env` and `.env.local`
# are gitignored; keep secrets there.

# ---------------------------------------------------------------------------
# apps/api  (server-side only — none of these may reach the browser)
# ---------------------------------------------------------------------------

# Raises GitHub rate limits. End users never authenticate (spec §6, D-01).
GITHUB_TOKEN=

# LLM provider key, used for repo overviews and contribution briefs.
ANTHROPIC_API_KEY=

# Supabase project URL: https://<project-ref>.supabase.co
SUPABASE_URL=

# The SECRET (service role) key. It bypasses RLS, which is how the API reads
# and writes — every table is deny-all for anon/authenticated by design (D-18).
# Server-side only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Port the API listens on.
PORT=3001

# ---------------------------------------------------------------------------
# apps/web  (NEXT_PUBLIC_* values are inlined into the browser bundle)
# ---------------------------------------------------------------------------

# Base URL of apps/api.
NEXT_PUBLIC_API_URL=http://localhost:3001
