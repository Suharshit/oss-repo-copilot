# Server-side GitHub token (raises rate limits; end users never authenticate)
GITHUB_TOKEN=

# Google Gemini key used for repo overviews and contribution briefs
GEMINI_API_KEY=

# Gemini model id. Must be the API id, e.g. gemini-3.6-flash.
MODEL=gemini-3.6-flash

# Supabase — cache for generated overviews and briefs.
# Remote:  https://<project-ref>.supabase.co
# Local:   http://127.0.0.1:54321  (from `pnpm db:start`)
SUPABASE_URL=

# The SECRET (service role) key. It bypasses RLS, which is how this API reads
# and writes — every table is deny-all for anon/authenticated by design.
# Server-side only. Never prefix this with NEXT_PUBLIC_ or send it to a browser.
SUPABASE_SECRET_KEY=

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

PORT=3001

# Set to 1 ONLY when a proxy in front of this API sets X-Forwarded-For.
# The rate limiter keys on the client IP; anywhere else this header is
# attacker-controlled and would hand out a fresh limit per request.
TRUST_PROXY=0
