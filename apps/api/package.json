{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.7",
    "@repo/shared": "workspace:*",
    "@supabase/supabase-js": "2.115.0",
    "hono": "4.10.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "esbuild": "0.25.12",
    "eslint": "10.9.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  }
}
